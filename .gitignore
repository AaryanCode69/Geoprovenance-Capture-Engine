# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# QGIS
*.qgs~
*.qgz~
.qgis2/
geoprov-dev/
# pytest-qgis drops a settings directory here when the suite is run inside QGIS
.qgis-settings/

# The visual demo's generated artefacts (qgis_demo/README.md explains the rebuild).
# The three INPUT datasets and the source scripts are committed; everything QGIS
# or the exporter produces from them is not — it is all regenerable with one
# command, and a 100 KB GeoPackage rewritten on every run is churn, not history.
qgis_demo/data/derived/
qgis_demo/project/
qgis_demo/_hooks/
qgis_demo/findings.txt

# Runtime provenance databases (RULES.md §10.4)
# NOTE: tests/fixtures/*.db is deliberately NOT ignored — it is a shared
# contract artefact consumed by Person B and Person C (RULES.md §10.3).
*.db
*.db-wal
*.db-shm
!tests/fixtures/*.db
demos/_scratch/

# Benchmark datasets — too large to version.
# experiments/README.md documents how to fetch them. (RULES.md §10.4)
experiments/data/
*.tif
*.tiff
*.jp2
!tests/fixtures/data/**

# Editor / OS / tooling
.claude/
.vscode/
.idea/
*.swp
.DS_Store
